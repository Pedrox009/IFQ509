#This part should allow us to take screenshots of the new data types to show that we 
# understand every single variable, what their original data type was that Pandas 
# gave it when it originally read the CSV, motivate why we need to change it, 
# then show how we changed it, and then display how they have been changed. 
df_typed = df_raw.copy(deep=True)

categorical_columns = [
    "region", "country", "gender", "age", "blood_type", "insurance",
    "income", "smoking", "working", "risk_infection_level"
]

binary_columns = [
    "covid19_positive", "covid19_symptoms", "covid19_contact", "asthma",
    "kidney_disease", "liver_disease", "compromised_immune",
    "heart_disease", "lung_disease", "diabetes", "hiv_positive",
    "other_chronic", "nursing_home", "health_worker"
]

df_typed["Participant_ID"] = df_typed["Participant_ID"].astype("string")
df_typed["survey_date"] = pd.to_datetime(
    df_typed["survey_date"], format="%d/%m/%Y", errors="raise"
)

for column in categorical_columns:
    df_typed[column] = df_typed[column].astype("category")

for column in binary_columns:
    df_typed[column] = df_typed[column].astype("Int64")

corrected_dtypes = df_typed.dtypes.astype(str).rename("corrected_dtype").to_frame()
display(original_dtypes.join(corrected_dtypes))

